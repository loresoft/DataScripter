{
  "name": "data-scripter",
  "displayName": "Data Scripter",
  "description": "Generate a MERGE script for the data in a SQL Server table or view",
  "version": "2.0.0",
  "publisher": "loresoft",
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/loresoft/DataScripter.git"
  },
  "license": "MIT",
  "pricing": "Free",
  "sponsor": {
    "url": "https://github.com/sponsors/loresoft"
  },
  "homepage": "https://github.com/loresoft/DataScripter",
  "bugs": {
    "url": "https://github.com/loresoft/DataScripter/issues"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "Script",
    "Insert",
    "Merge",
    "SQL",
    "SQL Server",
    "mssql"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "ms-mssql.mssql"
  ],
  "contributes": {
    "commands": [
      {
        "command": "data-scripter.generateMergeScript",
        "title": "Script Data as Merge"
      }
    ],
    "configuration": {
      "title": "Data Scripter",
      "properties": {
        "dataScripter.singleLine": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Script each list of columns on a single line instead of one column per line. This applies to the source columns, the `INSERT` columns and values, and the `UPDATE SET` assignments."
        },
        "dataScripter.skipColumns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [],
          "markdownDescription": "Names of columns to leave out of the default query, such as `Created` or `Updated`. Names are matched without regard to case, in every table and view. Add a column back to the query to script it."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "data-scripter.generateMergeScript",
          "when": "false"
        }
      ],
      "mssql.sqlScriptsSubmenu": [
        {
          "command": "data-scripter.generateMergeScript",
          "when": "view == objectExplorer && viewItem =~ /\\btype=(Table)\\b/",
          "group": "1_scripts@3"
        }
      ],
      "view/item/context": [
        {
          "command": "data-scripter.generateMergeScript",
          "when": "view == objectExplorer && viewItem =~ /\\btype=(View)\\b/",
          "group": "3_MSSQL_script@6"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile && npm run lint",
    "test": "mocha",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.105.0",
    "@vscode/vsce": "^4.1.1",
    "eslint": "^10.15.0",
    "mocha": "^12.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
